"express": "^5.0.1",
"helmet": "^8.0.0",
"jsonwebtoken": "^9.0.2",
"node-cron": "^3.0.3",
"node-fetch": "^3.3.2",
"pg": "^8.13.1"
},
"devDependencies": {
"@tsconfig/node-lts": "^22.0.0",
"@types/bcrypt": "^5.0.2",
"@types/cors": "^2.8.17",
"@types/express": "^5.0.0",
"@types/jsonwebtoken": "^9.0.7",
