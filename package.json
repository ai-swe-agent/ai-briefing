{
"name": "ai-briefing",
"version": "1.0.0",
"description": "AI news briefing backend with Express and TypeScript",
"type": "module",
"main": "dist/index.js",
"scripts": {
"build": "tsc",
"start": "node dist/index.js",
"dev": "tsx watch src/index.ts",
    "type-check": "tsc --noEmit",
    "migrate": "tsx src/db/migrate.ts",
    "crawl": "tsx src/services/runCrawler.ts"
},
"keywords": [
"ai",
"news",
"briefing",
"express",
"typescript"
],
"author": "",
"license": "MIT",
